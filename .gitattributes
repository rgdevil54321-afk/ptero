# Shell scripts must stay LF (they run on Linux servers).
*.sh text eol=lf

# The Laravel console entrypoint has no extension, so it would otherwise be
# subjected to core.autocrlf and get CRLF endings.
artisan text eol=lf

# The Turtle panel's PHP (forked from Hyper) is ionCube-encoded. Line-ending
# conversion corrupts encoded payloads, so treat every .php file as binary
# (stored verbatim).
*.php binary

# License/material byte-exact files.
*.key binary

# Built front-end bundles under public/assets are shipped verbatim and are
# referenced by Subresource-Integrity (sha384) hashes in public/assets/
# manifest.json. Any line-ending conversion would change the bytes and make the
# browser refuse to load them, so store them exactly as built.
public/assets/** -text

# SQL dumps are piped straight into the mysql client on Linux; CRLF can break
# statements, so force LF.
*.sql text eol=lf